{
	"compilerOptions": {
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node", "vitest/globals"]
	},
	"include": ["sst.config.ts", "infra/**/*.ts", "vitest.config.ts"]
}
