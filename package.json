{
	"name": "@bearfire-dev/tailscale-railway-quic-bridge",
	"version": "0.0.0-development",
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22",
		"pnpm": "10.34.5"
	},
	"scripts": {
		"build:metadata": "node infra/generate-build.mjs",
		"build:package": "tsup infra/index.ts --format esm --dts --clean && cp infra/edge/compose.yml dist/compose.yml && mkdir -p dist/templates/railway && cp templates/railway/railway.toml dist/templates/railway/railway.toml",
		"prepack": "pnpm build:package",
		"check:infra": "sst install && tsc --noEmit",
		"test:infra": "vitest run",
		"diff": "sst diff",
		"deploy": "sst deploy",
		"remove": "sst remove"
	},
	"dependencies": {
		"@pulumi/command": "1.2.1",
		"@pulumi/digitalocean": "4.78.0",
		"@pulumi/pulumi": "3.256.0",
		"@pulumi/tls": "5.5.1",
		"@sst-provider/railway": "0.6.1",
		"sst": "4.17.1"
	},
	"devDependencies": {
		"@types/node": "22.18.12",
		"tsup": "8.5.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
