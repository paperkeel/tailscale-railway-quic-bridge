TB_CONNECTOR_ID=railway-production
TB_ENVIRONMENT=production
TB_QUIC_LISTEN_ADDR=:4433
TB_TCP_LISTEN_ADDR=[::]:15001
TB_UDP_LISTEN_ADDR=[::]:15002
TB_MAX_UDP_FLOWS=4096
TB_MTLS_CA_B64=replace-me
TB_MTLS_CERT_B64=replace-me
TB_MTLS_KEY_B64=replace-me
TS_AUTHKEY=replace-me
TS_HOSTNAME=tailbridge-production
TS_STATE_DIR=/var/lib/tailscale
TS_AUTH_ONCE=true
TS_USERSPACE=false
TS_EXTRA_ARGS=--advertise-routes=fd12::/16 --advertise-tags=tag:tailbridge
